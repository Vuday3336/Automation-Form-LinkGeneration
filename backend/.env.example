# Copy this file to ".env" (same folder) and fill in real values.
# ".env" is git-ignored — never commit it or paste its contents anywhere.

# Port the API listens on
PORT=5000

# development | test | production
NODE_ENV=development

# Supabase Postgres connection string.
# Supabase Dashboard → your project → "Connect" button → "Session pooler" → copy the URI,
# then replace [YOUR-PASSWORD] with your database password. Shape:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Keep "require" for Supabase. ("disable" is only for a plain local Postgres without TLS.)
DATABASE_SSL=require

# Optional: full path to Supabase's CA certificate (Project Settings → Database → SSL Configuration
# → Download certificate). When set, the server's identity is verified, not just encrypted.
DATABASE_SSL_CA_PATH=

# Long random string used to sign login tokens. Generate with: npm run secret
JWT_SECRET=

# Long random string shared with Google Apps Script (Script Properties). Generate with: npm run secret
INTEGRATION_SECRET=

# Long random string used to encrypt patient names and form answers in the database.
# Generate with: npm run secret. WARNING: if you lose or change it, already-stored data can't be decrypted.
FIELD_ENCRYPTION_KEY=

# Where the React app runs (used for CORS). Comma-separate several origins if needed.
FRONTEND_URL=http://localhost:5173

# Base URL used when building secure submission links (usually the same as FRONTEND_URL)
LINK_BASE_URL=http://localhost:5173

# How long a generated secure link stays valid, in hours (default 72)
LINK_TTL_HOURS=72

# How long a login session lasts (jsonwebtoken format: 15m, 8h, 1d)
JWT_EXPIRES_IN=8h

# Used only by "npm run seed" to create the first Super Admin. Pick your own; min 12 characters.
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
