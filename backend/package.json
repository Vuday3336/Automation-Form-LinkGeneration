{
  "name": "hospitalform-ai-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Express API for HospitalForm AI: receives Google Form submissions, stores them in Supabase (PostgreSQL) and serves the dashboard.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "secret": "node -e \"console.log(require('crypto').randomBytes(48).toString('hex'))\""
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "supertest": "^7.3.1"
  }
}
