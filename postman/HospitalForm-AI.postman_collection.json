{
  "info": {
    "name": "HospitalForm AI",
    "description": "API requests for HospitalForm AI. Run 'Auth → Login' first: Postman keeps the hf_session cookie for the other requests. Set the collection variables (Variables tab) before starting; never commit real secrets.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "email", "value": "admin@hospitalform.test" },
    { "key": "password", "value": "<SEED_ADMIN_PASSWORD from backend/.env>" },
    { "key": "integrationSecret", "value": "<INTEGRATION_SECRET from backend/.env>" },
    { "key": "submissionId", "value": "" },
    { "key": "secureToken", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/health" }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        { "name": "Me", "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/me" } },
        {
          "name": "Register user (admin only)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Staff Member\",\n  \"email\": \"new.staff@hospitalform.test\",\n  \"password\": \"choose-a-long-password\",\n  \"role\": \"staff\",\n  \"hospitalAccess\": [\"<hospital id from GET /api/hospitals>\"]\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        { "name": "Logout", "request": { "method": "POST", "url": "{{baseUrl}}/api/auth/logout" } }
      ]
    },
    {
      "name": "Google Form integration",
      "item": [
        {
          "name": "1. Submit (success) – saves submissionId & token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('stored', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "if (body.data) {",
                  "  pm.collectionVariables.set('submissionId', body.data.submissionId);",
                  "  if (body.data.secureUrl) pm.collectionVariables.set('secureToken', body.data.secureUrl.split('/').pop());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Integration-Secret", "value": "{{integrationSecret}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source\": \"google_form\",\n  \"sourceResponseId\": \"postman-{{$timestamp}}\",\n  \"formTitle\": \"Postman Test\",\n  \"submittedAt\": \"{{$isoTimestamp}}\",\n  \"answers\": [\n    { \"question\": \"Hospital Name\", \"answer\": \"Demo City General Hospital\" },\n    { \"question\": \"Department\", \"answer\": \"Radiology\" },\n    { \"question\": \"Submission Type\", \"answer\": \"Equipment Request\" },\n    { \"question\": \"Patient Name\", \"answer\": \"Test Patient Golf\" },\n    { \"question\": \"Request Details\", \"answer\": \"Dummy request from Postman\" }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/integrations/google-form/submissions"
          }
        },
        {
          "name": "2. Invalid secret → 401",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Integration-Secret", "value": "wrong-secret" }
            ],
            "body": { "mode": "raw", "raw": "{ \"sourceResponseId\": \"x\", \"submittedAt\": \"2026-10-30T09:00:00Z\", \"answers\": [{ \"question\": \"Hospital Name\", \"answer\": \"Demo City General Hospital\" }] }" },
            "url": "{{baseUrl}}/api/integrations/google-form/submissions"
          }
        },
        {
          "name": "3. Duplicate (send twice) → 200 duplicate:true",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Integration-Secret", "value": "{{integrationSecret}}" }
            ],
            "body": { "mode": "raw", "raw": "{ \"sourceResponseId\": \"postman-duplicate-check\", \"submittedAt\": \"2026-10-30T09:00:00Z\", \"answers\": [{ \"question\": \"Hospital Name\", \"answer\": \"Demo City General Hospital\" }] }" },
            "url": "{{baseUrl}}/api/integrations/google-form/submissions"
          }
        },
        {
          "name": "4. Missing hospital → 400",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Integration-Secret", "value": "{{integrationSecret}}" }
            ],
            "body": { "mode": "raw", "raw": "{ \"sourceResponseId\": \"postman-missing\", \"submittedAt\": \"2026-10-30T09:00:00Z\", \"answers\": [{ \"question\": \"Department\", \"answer\": \"Radiology\" }] }" },
            "url": "{{baseUrl}}/api/integrations/google-form/submissions"
          }
        },
        { "name": "Integration info (Super Admin)", "request": { "method": "GET", "url": "{{baseUrl}}/api/integrations/google-form/info" } },
        { "name": "Send test submission (Super Admin)", "request": { "method": "POST", "url": "{{baseUrl}}/api/integrations/google-form/test" } }
      ]
    },
    {
      "name": "Submissions",
      "item": [
        {
          "name": "List (search, filters, sort, pagination)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/submissions?page=1&limit=20&status=Pending&search=&sortBy=submittedAt&order=desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "submissions"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "status", "value": "Pending" },
                { "key": "search", "value": "" },
                { "key": "sortBy", "value": "submittedAt" },
                { "key": "order", "value": "desc" }
              ]
            }
          }
        },
        { "name": "Get by ID", "request": { "method": "GET", "url": "{{baseUrl}}/api/submissions/{{submissionId}}" } },
        { "name": "Open secure link", "request": { "method": "GET", "url": "{{baseUrl}}/api/submissions/secure/{{secureToken}}" } },
        {
          "name": "Update status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"status\": \"Under Review\" }" },
            "url": "{{baseUrl}}/api/submissions/{{submissionId}}/status"
          }
        },
        {
          "name": "Update details",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"department\": \"Cardiology\" }" },
            "url": "{{baseUrl}}/api/submissions/{{submissionId}}"
          }
        },
        { "name": "Regenerate link", "request": { "method": "POST", "url": "{{baseUrl}}/api/submissions/{{submissionId}}/link" } },
        { "name": "Revoke link", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/submissions/{{submissionId}}/link" } },
        { "name": "Archive (soft delete)", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/submissions/{{submissionId}}" } }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        { "name": "Stats", "request": { "method": "GET", "url": "{{baseUrl}}/api/dashboard/stats" } },
        { "name": "Recent submissions", "request": { "method": "GET", "url": "{{baseUrl}}/api/dashboard/recent-submissions" } },
        { "name": "Department stats", "request": { "method": "GET", "url": "{{baseUrl}}/api/dashboard/department-stats" } }
      ]
    },
    {
      "name": "Admin",
      "item": [
        { "name": "Hospitals", "request": { "method": "GET", "url": "{{baseUrl}}/api/hospitals" } },
        { "name": "Users", "request": { "method": "GET", "url": "{{baseUrl}}/api/users" } },
        { "name": "Audit logs", "request": { "method": "GET", "url": "{{baseUrl}}/api/audit-logs?page=1&limit=50" } }
      ]
    }
  ]
}
